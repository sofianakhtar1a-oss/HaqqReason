# ─────────────────────────────────────────────────────────────
# HaqqReason — réglages du serveur
# Copie ce fichier sous le nom « .env.local » et remplis chaque ligne.
# Ne partage JAMAIS le fichier .env.local et ne le mets jamais en ligne.
# ─────────────────────────────────────────────────────────────

# Supabase > Project Settings > Data API : « Project URL »
SUPABASE_URL=

# Supabase > Project Settings > API Keys : clé « Publishable » (commence par sb_publishable_)
SUPABASE_PUBLISHABLE_KEY=

# Supabase > Project Settings > API Keys : clé « Secret » (commence par sb_secret_)
# C'est la clé la plus sensible : elle donne tous les droits sur la base.
SUPABASE_SECRET_KEY=

# Deux secrets à générer avec la commande :  npm run secrets
SESSION_SECRET=
SETUP_TOKEN=

# Facultatif : minutes d'inactivité avant déconnexion automatique du créateur (30 par défaut)
SESSION_IDLE_MINUTES=30

# Phase 6 — secret de la sauvegarde automatique quotidienne (généré par  npm run secrets)
# À mettre aussi dans Vercel : sans lui, la sauvegarde de chaque nuit ne se déclenche pas.
CRON_SECRET=

# Facultatif : adresse publique du site (ex. https://haqqreason.vercel.app), pour les aperçus de partage.
# Sur Vercel, elle est détectée toute seule.
SITE_URL=

# Facultatif : code de vérification Google Search Console (méthode « Balise HTML », seulement la valeur de content="…").
GOOGLE_SITE_VERIFICATION=

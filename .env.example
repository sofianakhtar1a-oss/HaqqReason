# ─────────────────────────────────────────────────────────────
# HaqqReason — réglages du serveur
# Copie ce fichier sous le nom « .env.local » et remplis chaque ligne.
# Ne partage JAMAIS le fichier .env.local et ne le mets jamais en ligne.
# ─────────────────────────────────────────────────────────────

# Supabase > Project Settings > Data API : « Project URL »
SUPABASE_URL=

# Supabase > Project Settings > API Keys : clé « Publishable » (commence par sb_publishable_)
SUPABASE_PUBLISHABLE_KEY=

# Supabase > Project Settings > API Keys : clé « Secret » (commence par sb_secret_)
# C'est la clé la plus sensible : elle donne tous les droits sur la base.
SUPABASE_SECRET_KEY=

# Deux secrets à générer avec la commande :  npm run secrets
SESSION_SECRET=
SETUP_TOKEN=

# Facultatif : minutes d'inactivité avant déconnexion automatique du créateur (30 par défaut)
SESSION_IDLE_MINUTES=30

# Phase 6 — secret de la sauvegarde automatique quotidienne (généré par  npm run secrets)
# À mettre aussi dans Vercel : sans lui, la sauvegarde de chaque nuit ne se déclenche pas.
CRON_SECRET=

# Facultatif : adresse publique du site (ex. https://haqqreason.vercel.app), pour les aperçus de partage.
# Sur Vercel, elle est détectée toute seule.
SITE_URL=

# Facultatif : code de vérification Google Search Console (méthode « Balise HTML », seulement la valeur de content="…").
GOOGLE_SITE_VERIFICATION=

# Phase 15 — L'Alambic, outil « Transcrire » (transcription Whisper et traduction, palier gratuit de Groq).
# Créer une clé gratuite (sans carte bancaire) sur https://console.groq.com/keys, puis la mettre aussi dans Vercel.
# Sans elle, l'outil s'affiche mais indique que la clé manque.
GROQ_API_KEY=
# Facultatif : changer de modèle sans toucher au code (valeurs par défaut ci-dessous).
# GROQ_MODELE_AUDIO=whisper-large-v3
# GROQ_MODELE_TEXTE=openai/gpt-oss-120b
# GROQ_MODELE_MOTS=openai/gpt-oss-120b

# Phase 16 — L'Alambic, outil « Interroger » (assistant de recherche sur tes sources, Gemini, palier gratuit).
# Créer une clé gratuite sur https://aistudio.google.com/apikey, puis la mettre aussi dans Vercel.
GEMINI_API_KEY=
# Facultatif : changer de modèle sans toucher au code.
# GEMINI_MODELE=gemini-3.8-flash
# GEMINI_MODELE_VECTEURS=gemini-embedding-001

# Phase 21 — connexion des utilisateurs avec Google (voir docs/GUIDE-PHASE-21.md).
# Rien à remplir : l'identifiant public de l'application HaqqReason est déjà dans le code
# (lib/compte/jeton.ts) et AUCUN code secret Google n'est nécessaire.
# Facultatif : un autre identifiant (projet Google différent, essais en local).
# GOOGLE_CLIENT_ID=
# Facultatif : « non » coupe la connexion Google (le mode utilisateur redevient ouvert sans compte).
# GOOGLE_CONNEXION=non

# Le Calame — relecture grammaticale. Facultatif : sans réglage, le service public gratuit de LanguageTool
# est utilisé (environ 20 relectures par minute). Pour un serveur LanguageTool à soi, mettre son adresse /v2/check.
# LANGUAGETOOL_URL=https://api.languagetool.org/v2/check

# L'offre Premium (paiement par Stripe) — voir docs/GUIDE-PREMIUM.md.
# Sans ces deux lignes, l'offre reste éteinte et tout le site reste gratuit.
# Une clé restreinte (rk_live_…) avec les seuls droits listés dans le guide est la plus sûre ;
# une clé secrète (sk_live_…) marche aussi. À mettre dans Vercel, jamais ailleurs.
# STRIPE_SECRET_KEY=
# Le secret de signature du webhook (whsec_…), donné par Stripe à la création du webhook.
# STRIPE_WEBHOOK_SECRET=

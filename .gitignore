# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# Copié automatiquement après npm install (scripts/copier-ressources.mjs)
/public/vendor

# Les captures comparées du Portulan (références et rapport) restent sur la machine qui les fait.
/tests/captures/

# L'Écorché : la haute définition (niveau 0) n'est versionnée qu'une fois publiée (scripts/corps/donnees/publication.json)
/public/corps/*-[pi]0-*.bin

# Python
__pycache__/

5,297,302,305,319,334,344,350,366,382,387,388,413,422,429,432,433,443],"pages":[{"p":[[["Hugo is nine years old.","Hugo a neuf ans.",[0,1,2,3,4]],["It is Saturday morning.","C'est samedi matin.",[5,1,6,7]],["Hugo is in the kitchen with Mum and Dad.","Hugo est dans la cuisine avec maman et papa.",[0,1,8,9,10,11,12,13,14]],["Mum has a cup of tea.","Maman a une tasse de thé.",[12,15,16,17,18,19]],["Dad makes toast.","Papa fait des toasts.",[14,20,21]],["Hugo eats his cereal.","Hugo mange ses céréales.",[0,22,23,24]]],[["The doorbell rings.","On sonne à la porte.",[9,25,26]],["A man brings a big box.","Un homme apporte une grande boîte.",[16,27,28,16,29,30]],["The box is very big.","La boîte est très grande.",[9,30,1,31,29]],["It is taller than Hugo!","Elle est plus haute que Hugo !",[5,1,32,33,0]],["“This is for you,” he says.","« C'est pour vous », dit-il.",[34,1,35,36,37,38]],["“Thank you!” says Mum.","« Merci ! » dit maman.",[39,40,38,12]],["She reads the label.","Elle lit l'étiquette.",[41,42,9,43]],["“It is a present from Aunt Nadia.”","« C'est un cadeau de tante Nadia. »",[5,1,16,44,45,46,47]]],[["“What is in the box?” asks Hugo.","« Qu'y a-t-il dans la boîte ? » demande Hugo.",[48,1,8,9,30,49,0]],["Dad opens it.","Papa l'ouvre.",[14,50,5]],["Two blue lights shine inside.","Deux lumières bleues brillent à l'intérieur.",[51,52,53,54,55]],["“Hello!” says a small voice.","« Bonjour ! » dit une petite voix.",[56,38,16,57,58]],["“I am Bip.”","« Je suis Bip. »",[59,60,61]],["“I am a robot.”","« Je suis un robot. »",[59,60,16,62]],["“I help at home.”","« J'aide à la maison. »",[59,63,64,65]],["Hugo's mouth is open.","Hugo a la bouche ouverte.",[66,67,1,68]],["“Wow!” he says.","« Waouh ! » dit-il.",[69,37,38]]]],"m":[25,44,24,43,54,58,62,69,3,4,7,10],"t":"Chapter 1 — The big box","tf":"Chapitre 1 — La grande boîte"},{"p":[[["Bip is small and round.","Bip est petit et rond.",[61,1,70,13,71]],["He has a blue head and two long arms.","Il a une tête bleue et deux longs bras.",[37,15,16,72,73,13,51,74,75]],["He has wheels, not legs.","Il a des roues, pas des jambes.",[37,15,76,77,78]],["His eyes are two round lights.","Ses yeux sont deux lumières rondes.",[23,79,80,51,81,53]],["“Can you really help us?” asks Hugo.","« Tu peux vraiment nous aider ? » demande Hugo.",[82,36,83,84,85,49,0]],["“Yes, I can,” says Bip.","« Oui, je peux », dit Bip.",[86,59,82,38,61]],["“Give me a job, please.”","« Donne-moi une tâche, s'il te plaît. »",[87,88,16,89,90]]],[["Mum smiles.","Maman sourit.",[12,91]],["She has a pile of clean socks.","Elle a une pile de chaussettes propres.",[41,15,16,92,18,93,94]],["“Bip, please put the socks away,” she says.","« Bip, range les chaussettes, s'il te plaît », dit-elle.",[61,90,95,9,94,96,41,38]],["“Yes, Mum!” says Bip.","« Oui, maman ! » dit Bip.",[86,12,38,61]],["He takes the socks and rolls to the kitchen.","Il prend les chaussettes et roule jusqu'à la cuisine.",[37,97,9,94,13,98,99,9,10]],["He opens the fridge.","Il ouvre le frigo.",[37,50,9,100]],["He puts the socks next to the milk and the cheese.","Il pose les chaussettes à côté du lait et du fromage.",[37,101,9,94,102,103,9,104,13,9,105]],["“Job done!” says Bip.","« Travail terminé ! » dit Bip.",[106,107,38,61]],["Dad laughs and laughs.","Papa rit à n'en plus finir.",[14,108,13,108]],["“Bip, the socks go in a drawer, not in the fridge!”","« Bip, les chaussettes vont dans un tiroir, pas dans le frigo ! »",[61,9,94,109,8,16,110,77,8,9,100]],["Hugo laughs too.","Hugo rit aussi.",[0,108,111]],["Bip does not understand.","Bip ne comprend pas.",[61,107,77,112]]]],"m":[76,92,96,98,110,70,71,72,73,74,75,78]},{"p":[[["Nougat is the family cat.","Nougat est le chat de la famille.",[113,1,9,114,115]],["He is orange and very lazy.","Il est roux et très paresseux.",[37,1,116,13,31,117]],["He loves milk and fish.","Il adore le lait et le poisson.",[37,118,104,13,119]],["He sleeps on the sofa, next to a green plant.","Il dort sur le canapé, à côté d'une plante verte.",[37,120,121,9,122,102,103,16,123,124]]],[["“Bip, please water the plant,” says Dad.","« Bip, arrose la plante, s'il te plaît », dit papa.",[61,90,125,9,124,38,14]],["“Yes, Dad!” says Bip.","« Oui, papa ! » dit Bip.",[86,14,38,61]],["He takes a jug of water and rolls to the sofa.","Il prend une cruche d'eau et roule jusqu'au canapé.",[37,97,16,126,18,127,13,98,99,9,122]],["He looks at the plant.","Il regarde la plante.",[37,128,129,9,124]],["He looks at Nougat.","Il regarde Nougat.",[37,128,129,113]],["“This plant is orange and soft,” says Bip.","« Cette plante est orange et douce », dit Bip.",[34,124,1,130,13,131,38,61]],["“It has a tail. It is a funny plant.”","« Elle a une queue. C'est une drôle de plante. »",[5,15,16,132,5,1,16,133,124]],["Splash!","Plouf !",[134]],["Nougat opens his eyes wide.","Nougat ouvre grand les yeux.",[113,135,23,79,136]],["The water falls on Nougat's head.","L'eau tombe sur la tête de Nougat.",[9,127,137,121,138,73]],["“Meow!” Nougat jumps up and runs away.","« Miaou ! » Nougat bondit et s'enfuit en courant.",[139,113,140,141,13,142,143]],["“Bip, that is not a plant!” shouts Hugo.","« Bip, ce n'est pas une plante ! » crie Hugo.",[61,144,1,77,16,124,145,0]],["“That is Nougat, our cat!”","« C'est Nougat, notre chat ! »",[144,1,113,146,115]],["“Sorry, Nougat,” says Bip in a small voice.","« Pardon, Nougat », dit Bip d'une petite voix.",[147,113,38,61,148,16,57,58]]]],"m":[139,123,128,134,117,124,126,98,131,132,136,137],"t":"Chapter 2 — Bip's mistakes","tf":"Chapitre 2 — Les erreurs de Bip"},{"p":[[["Nougat hides under the table.","Nougat se cache sous la table.",[113,149,150,9,151]],["He is wet, but he is fine.","Il est mouillé, mais il va bien.",[37,1,152,153,37,1,154]],["He is not happy.","Il n'est pas content.",[37,1,77,155]],["Hugo comes with a big towel.","Hugo arrive avec une grande serviette.",[0,156,11,16,29,157]],["“Come here, Nougat,” he says softly.","« Viens ici, Nougat », dit-il doucement.",[158,159,113,37,38,160]],["He dries the cat.","Il sèche le chat.",[37,161,9,115]],["Bip watches and says nothing.","Bip regarde et ne dit rien.",[61,162,13,38,163]],["Nougat looks at Bip with big round eyes.","Nougat regarde Bip avec de grands yeux ronds.",[113,128,129,61,11,164,165,79]]],[["Then Mum says, “Bip, please turn off the light.”","Puis maman dit : « Bip, éteins la lumière, s'il te plaît. »",[166,12,38,61,90,167,168,9,169]],["Bip turns off the light.","Bip éteint la lumière.",[61,170,171,9,169]],["He turns off the TV and the radio too.","Il éteint aussi la télé et la radio.",[37,170,171,9,172,13,9,173,111]],["Then he turns off the fridge!","Puis il éteint le frigo !",[166,37,170,171,9,100]],["The kitchen is dark and quiet.","La cuisine est sombre et silencieuse.",[9,10,1,174,13,175]],["“Oh dear,” says Mum.","« Oh là là », dit maman.",[176,177,38,12]],["“Bip is kind, but he does not understand us.”","« Bip est gentil, mais il ne nous comprend pas. »",[61,1,178,153,37,107,77,112,85]],["Hugo thinks for a minute.","Hugo réfléchit une minute.",[0,179,35,16,180]],["“I have an idea,” he says.","« J'ai une idée », dit-il.",[59,181,182,183,37,38]],["“I can teach him.”","« Je peux lui apprendre. »",[59,82,184,185]]]],"m":[154,160,128,168,149,152,161,177,184,151,155,156]},{"p":[[["Hugo takes a pen and a big piece of paper.","Hugo prend un stylo et une grande feuille de papier.",[0,97,16,186,13,16,29,187,18,188]],["Bip rolls into Hugo's room.","Bip roule jusque dans la chambre de Hugo.",[61,98,189,66,190]],["There is a desk by the window.","Il y a un bureau près de la fenêtre.",[191,1,16,192,193,9,194]],["He writes “Bip's rules” at the top.","Il écrit « Les règles de Bip » en haut.",[37,195,196,197,198,9,199]],["“Come here, Bip,” he says.","« Viens ici, Bip », dit-il.",[158,159,61,37,38]],["“Sit down and listen.”","« Assieds-toi et écoute. »",[200,201,13,202]]],[["“Rule one,” says Hugo.","« Règle numéro un », dit Hugo.",[203,204,38,0]],["Rule one is very important.","La règle numéro un est très importante.",[203,205,1,31,206]],["“Listen to the words.”","« Écoute bien les mots. »",[202,207,9,208]],["He says each rule slowly.","Il dit chaque règle lentement.",[37,38,209,203,210]],["“A plant is green. A cat is not a plant.”","« Une plante est verte. Un chat n'est pas une plante. »",[16,124,1,123,16,115,1,77,16,124]],["“Rule two. Ask, 'Is this right?'”","« Règle numéro deux. Demande : “C'est bien ça ?” »",[203,211,49,1,34,212]],["“Rule three. Look first, then act.”","« Règle numéro trois. Regarde d'abord, puis agis. »",[203,213,214,215,166,216]]],[["Bip's eyes go green.","Les yeux de Bip deviennent verts.",[196,79,217,218]],["“Listen. Ask. Look,” says Bip.","« Écouter. Demander. Regarder », dit Bip.",[219,220,221,38,61]],["“I understand!”","« Je comprends ! »",[59,222]],["Beep, beep.","Bip, bip.",[223,223]],["He puts the rules in his memory.","Il met les règles dans sa mémoire.",[37,224,9,197,8,23,225]],["“Can you do it?” asks Hugo.","« Tu peux y arriver ? » demande Hugo.",[82,36,226,227,49,0]],["“I can try,” says Bip.","« Je peux essayer », dit Bip.",[59,82,228,38,61]]]],"m":[223,197,201,123,214,188,98,199,124,212,216,97],"t":"Chapter 3 — Hugo's rules","tf":"Chapitre 3 — Les règles de Hugo"},{"p":[[["Hugo teaches Bip more words.","Hugo apprend d'autres mots à Bip.",[0,229,61,230,208]],["Bip learns fast.","Bip apprend vite.",[61,231,232]],["“Socks go in the drawer,” he says.","« Les chaussettes vont dans le tiroir », dit-il.",[94,109,8,9,110,37,38]],["“Food goes in the fridge.”","« La nourriture va dans le frigo. »",[233,234,8,9,100]],["“Water is for plants, not for cats.”","« L'eau est pour les plantes, pas pour les chats. »",[127,1,35,235,77,35,236]],["Bip says the words again and again.","Bip répète les mots encore et encore.",[61,237,9,208,238,13,238]],["Soon he knows ten new words.","Bientôt, il connaît dix nouveaux mots.",[239,37,240,241,242,208]],["Bip's lights are bright and happy.","Les lumières de Bip sont vives et joyeuses.",[196,53,80,243,13,244]]],[["Mum comes in with more socks.","Maman entre avec d'autres chaussettes.",[12,245,246,11,230,94]],["Bip looks at the socks.","Bip regarde les chaussettes.",[61,128,129,9,94]],["He looks at the drawer.","Il regarde le tiroir.",[37,128,129,9,110]],["“Is this right, Mum?” he asks.","« C'est bien ça, maman ? » demande-t-il.",[1,34,212,12,37,49]],["“Yes, Bip. That is right!” says Mum.","« Oui, Bip. C'est bien ça ! » dit maman.",[86,61,247,1,212,38,12]],["Bip puts the socks in the drawer.","Bip met les chaussettes dans le tiroir.",[61,224,9,94,8,9,110]],["Everybody claps.","Tout le monde applaudit.",[248,249]],["Slowly, Nougat comes into the room.","Doucement, Nougat entre dans la pièce.",[250,113,251,189,9,252]],["He jumps on Bip's head and goes to sleep.","Il saute sur la tête de Bip et s'endort.",[37,253,121,196,73,13,254,255,256]],["“Nougat is not angry now,” says Hugo.","« Nougat n'est plus fâché maintenant », dit Hugo.",[113,1,77,257,258,38,0]]]],"m":[232,128,229,110,235,243,212,249,208,231,94,109]},{"p":[[["A week later, it is Sunday.","Une semaine plus tard, c'est dimanche.",[16,259,260,5,1,261]],["Today is Grandad's birthday.","Aujourd'hui, c'est l'anniversaire de papy.",[262,1,263,264]],["He is Mum's father.","C'est le père de maman.",[37,1,265,266]],["He loves chocolate.","Il adore le chocolat.",[37,118,267]],["He is seventy years old!","Il a soixante-dix ans !",[37,1,268,269,270]],["He comes to the house at five o'clock.","Il vient à la maison à cinq heures.",[37,271,99,9,272,64,273,274]]],[["Mum has a big chocolate cake.","Maman a un grand gâteau au chocolat.",[12,15,16,275,267,276]],["It has cream and red strawberries on top.","Il a de la crème et des fraises rouges sur le dessus.",[5,15,277,13,278,279,280,281]],["“It looks great!” says Hugo.","« Il a l'air super ! » dit Hugo.",[5,282,283,38,0]],["Dad puts up a long sign on the wall.","Papa accroche une longue banderole au mur.",[14,284,285,16,286,287,121,9,288]],["It says, “Happy Birthday, Grandad!”","Elle dit : « Joyeux anniversaire, papy ! »",[5,38,289,264,290]],["Bip blows up the balloons.","Bip gonfle les ballons.",[61,291,292,9,293]],["Before every balloon, he asks, “Is this right?”","Avant chaque ballon, il demande : « C'est bien ça ? »",[294,295,296,37,49,1,34,212]],["“Yes, Bip!” says Hugo.","« Oui, Bip ! » dit Hugo.",[86,61,38,0]]],[["Then Mum takes her bag.","Puis maman prend son sac.",[166,12,97,297,298]],["“Dad and I go to the shop for candles,” she says.","« Papa et moi, nous allons au magasin acheter des bougies », dit-elle.",[14,13,59,299,99,9,300,35,301,41,38]],["“We are back in forty minutes.”","« Nous revenons dans quarante minutes. »",[302,303,304,8,305,306]],["“Look after the cake, you two!”","« Surveillez le gâteau, vous deux ! »",[307,308,9,276,36,51]]]],"m":[263,282,277,281,287,291,293,212,301,259,264,265],"t":"Chapter 4 — Grandad's birthday","tf":"Chapitre 4 — L'anniversaire de papy"},{"p":[[["Hugo and Bip are alone in the kitchen.","Hugo et Bip sont seuls dans la cuisine.",[0,13,61,80,309,8,9,10]],["The kitchen is very quiet.","La cuisine est très calme.",[9,10,1,31,310]],["Hugo is a little nervous.","Hugo est un peu inquiet.",[0,1,16,311,312]],["The cake is on a big white plate.","Le gâteau est sur un grand plat blanc.",[9,276,1,121,16,275,313,314]],["“Bip, please bring the cake to the table,” says Hugo.","« Bip, apporte le gâteau à la table, s'il te plaît », dit Hugo.",[61,90,28,9,276,99,9,151,38,0]],["“Look first!”","« Regarde d'abord ! »",[214,215]],["Bip looks at the floor.","Bip regarde le sol.",[61,128,129,9,315]],["He looks at the door.","Il regarde la porte.",[37,128,129,9,316]],["He takes the plate with two careful hands.","Il prend le plat avec ses deux mains prudentes.",[37,97,9,314,11,51,317,318]],["Slowly, slowly, he rolls to the table.","Doucement, doucement, il roule vers la table.",[250,250,37,98,99,9,151]],["Everything looks fine.","Tout a l'air de bien se passer.",[319,282,154]]],[["Suddenly, Nougat jumps off a chair.","Soudain, Nougat saute d'une chaise.",[320,113,253,321,16,322]],["“Meow!”","« Miaou ! »",[139]],["Bip turns round quickly.","Bip se retourne vite.",[61,323,324,325]],["His arm hits the table.","Son bras heurte la table.",[23,326,327,9,151]],["The plate flies up in the air.","Le plat s'envole dans les airs.",[9,314,328,329,8,9,330]],["Splat!","Splatch !",[331]],["The cake is on the floor.","Le gâteau est par terre.",[9,276,1,332,9,333]],["There is chocolate and cream everywhere.","Il y a du chocolat et de la crème partout.",[191,1,267,13,277,334]],["Red strawberries roll under the table.","Des fraises rouges roulent sous la table.",[278,279,335,150,9,151]],["Nougat stays on the chair.","Nougat reste sur la chaise.",[113,336,121,9,322]],["Hugo's mouth is open again.","Hugo a de nouveau la bouche ouverte.",[66,67,1,68,238]]]],"m":[139,330,331,214,154,321,309,312,317,98,320,327]},{"p":[[["Bip's eyes go dark blue.","Les yeux de Bip deviennent bleu foncé.",[196,79,217,337,338]],["“I am sorry, Hugo,” he says.","« Je suis désolé, Hugo », dit-il.",[59,60,339,0,37,38]],["“It is a big mistake.”","« C'est une grosse erreur. »",[5,1,16,340,341]],["Hugo is sad for a minute.","Hugo est triste pendant une minute.",[0,1,342,35,16,180]],["He looks at the clock.","Il regarde l'horloge.",[37,128,129,9,343]],["It is three o'clock.","Il est trois heures.",[5,1,344,274]],["Hugo takes a deep breath.","Hugo respire profondément.",[0,345,16,346,347]]],[["“Grandad comes at five,” says Hugo.","« Papy vient à cinq heures », dit Hugo.",[290,271,64,273,38,0]],["“We have two hours.”","« Nous avons deux heures. »",[302,181,51,348]],["“Everybody makes mistakes, Bip.”","« Tout le monde fait des erreurs, Bip. »",[248,20,349,61]],["“Let's make a new cake!”","« Faisons un nouveau gâteau ! »",[350,351,16,352,276]],["Bip's eyes go bright green.","Les yeux de Bip deviennent d'un vert vif.",[196,79,217,353,354]],["He is ready to help.","Il est prêt à aider.",[37,1,355,99,84]],["“Yes!” he says.","« Oui ! » dit-il.",[86,37,38]]],[["Hugo picks up the phone and calls Mum.","Hugo prend le téléphone et appelle maman.",[0,356,357,9,358,13,359,12]],["Mum answers fast.","Maman répond vite.",[12,360,232]],["He tells her the truth.","Il lui dit la vérité.",[37,361,297,9,362]],["“Don't worry,” says Mum.","« Ne t'inquiète pas », dit maman.",[363,364,38,12]],["“Make the cake with Bip.”","« Fais le gâteau avec Bip. »",[365,9,276,11,61]],["“Don't use the oven alone.”","« N'utilise pas le four tout seul. »",[366,367,9,368,369]],["“I am home in half an hour.”","« Je rentre dans une demi-heure. »",[59,60,65,8,370,182,371]]]],"m":[290,128,354,232,362,341,346,347,353,356,364,368],"t":"Chapter 5 — Oh no!","tf":"Chapitre 5 — Oh non !"},{"p":[[["Bip finds the recipe book on the shelf.","Bip trouve le livre de recettes sur l'étagère.",[61,372,9,373,374,121,9,375]],["He reads very fast.","Il lit très vite.",[37,42,31,232]],["“We need flour, eggs, sugar, butter and chocolate,” he says.","« Il nous faut de la farine, des œufs, du sucre, du beurre et du chocolat », dit-il.",[302,376,377,378,379,380,13,267,37,38]],["Hugo opens the cupboard.","Hugo ouvre le placard.",[0,50,9,381]],["He puts everything on the table.","Il pose tout sur la table.",[37,101,319,121,9,151]],["Everything is ready.","Tout est prêt.",[319,1,355]]],[["Bip takes something white and soft.","Bip prend quelque chose de blanc et de doux.",[61,97,382,313,13,383]],["“Is this right?” he asks.","« C'est bien ça ? » demande-t-il.",[1,34,212,37,49]],["It is a clean white sock!","C'est une chaussette blanche et propre !",[5,1,16,384,385,386]],["“No, Bip!” laughs Hugo.","« Non, Bip ! » rit Hugo.",[387,61,108,0]],["“That is not flour. Socks go in the drawer!”","« Ce n'est pas de la farine. Les chaussettes vont dans le tiroir ! »",[144,1,77,377,94,109,8,9,110]],["“Oh yes,” says Bip.","« Ah oui », dit Bip.",[388,86,38,61]],["“Thank you for the rule.”","« Merci pour la règle. »",[39,40,35,9,203]]],[["Now Hugo counts the eggs.","Maintenant, Hugo compte les œufs.",[258,0,389,9,378]],["Bip puts the flour in a big bowl.","Bip met la farine dans un grand saladier.",[61,224,9,377,8,16,275,390]],["Then he stirs the cake mix.","Puis il remue la pâte du gâteau.",[166,37,391,9,392,393]],["Faster and faster!","De plus en plus vite !",[394,13,394]],["“Slowly, Bip!” shouts Hugo.","« Doucement, Bip ! » crie Hugo.",[250,61,145,0]],["There is chocolate on Hugo's nose.","Il y a du chocolat sur le nez de Hugo.",[191,1,267,121,66,395]]]],"m":[232,203,373,374,375,377,381,383,212,110,390,391],"t":"Chapter 6 — Two bakers","tf":"Chapitre 6 — Deux pâtissiers"},{"p":[[["Mum comes home at half past three.","Maman rentre à trois heures et demie.",[12,396,397,64,398,399,344]],["She puts the cake in the oven.","Elle met le gâteau au four.",[41,224,9,276,8,9,368]],["“Now we wait,” she says.","« Maintenant, nous attendons », dit-elle.",[258,302,400,41,38]],["The kitchen smells of hot chocolate.","La cuisine sent bon le chocolat chaud.",[9,10,401,18,402,267]]],[["Hugo and Bip clean the floor.","Hugo et Bip nettoient le sol.",[0,13,61,403,9,315]],["Bip looks first.","Bip regarde d'abord.",[61,214,215]],["Then he cleans the chocolate with a cloth.","Puis il nettoie le chocolat avec un chiffon.",[166,37,404,9,267,11,16,405]],["Dad hangs the balloons in the living room.","Papa accroche les ballons dans le salon.",[14,406,9,293,8,9,407,408]],["Nougat sleeps on the sofa again.","Nougat dort de nouveau sur le canapé.",[113,120,121,9,122,238]]],[["At last, the cake is ready.","Enfin, le gâteau est prêt.",[409,410,9,276,1,355]],["It is half past four.","Il est quatre heures et demie.",[5,1,411,412,413]],["It is a little flat and a little funny.","Il est un peu plat et un peu bizarre.",[5,1,16,311,414,13,16,311,415]],["But it smells wonderful!","Mais il sent merveilleusement bon !",[153,5,416,417]],["Hugo puts cream on the cake.","Hugo met de la crème sur le gâteau.",[0,224,277,121,9,276]],["Bip puts red strawberries on top.","Bip pose des fraises rouges sur le dessus.",[61,101,278,279,280,281]],["Mum puts in the candles.","Maman plante les bougies.",[12,418,419,9,301]],["A taxi stops outside the house.","Un taxi s'arrête devant la maison.",[16,420,421,422,9,272]]]],"m":[214,368,401,405,406,293,407,417,277,281,301,12]},{"p":[[["The door opens.","La porte s'ouvre.",[9,316,50]],["“Surprise!” shout Hugo, Bip, Mum and Dad.","« Surprise ! » crient Hugo, Bip, maman et papa.",[423,424,0,61,12,13,14]],["Grandad laughs and opens his arms.","Papy rit et ouvre les bras.",[290,108,13,50,23,75]],["“Happy birthday, Grandad!” says Hugo.","« Joyeux anniversaire, papy ! » dit Hugo.",[289,264,290,38,0]],["Everybody sings the birthday song.","Tout le monde chante la chanson d'anniversaire.",[248,425,9,264,426]],["Grandad blows out the candles.","Papy souffle les bougies.",[290,427,428,9,301]]],[["“Wow! Who is the baker?” asks Grandad.","« Waouh ! Qui est le pâtissier ? » demande papy.",[69,429,1,9,430,49,290]],["“Bip and I,” says Hugo.","« Bip et moi », dit Hugo.",[61,13,59,38,0]],["“We are the bakers.”","« Nous sommes les pâtissiers. »",[302,80,9,431]],["“The first cake was on the floor!”","« Le premier gâteau était par terre ! »",[9,432,276,433,332,9,333]],["“Bip is sorry, but we make a new one.”","« Bip est désolé, mais nous en faisons un nouveau. »",[61,1,339,153,302,351,16,352,434]],["Grandad eats a big piece.","Papy mange une grosse part.",[290,22,16,340,435]],["“This is the best cake in the world!” he says.","« C'est le meilleur gâteau du monde ! » dit-il.",[34,1,9,436,276,437,9,438,37,38]]],[["Then Bip comes with a small box.","Puis Bip arrive avec une petite boîte.",[166,61,156,11,16,57,30]],["“Happy birthday, Grandad,” he says.","« Joyeux anniversaire, papy », dit-il.",[289,264,290,37,38]],["Grandad opens the box.","Papy ouvre la boîte.",[290,50,9,30]],["It is full of new socks!","Elle est pleine de chaussettes neuves !",[5,1,439,18,440,94]],["“Socks! I need them!” laughs Grandad.","« Des chaussettes ! J'en ai besoin ! » rit papy.",[94,59,441,442,108,290]],["“They are not in the fridge,” says Bip.","« Elles ne sont pas dans le frigo », dit Bip.",[443,80,77,8,9,100,38,61]],["Everybody laughs.","Tout le monde rit.",[248,108]],["Nougat jumps on Bip's head.","Nougat saute sur la tête de Bip.",[113,253,121,196,73]],["Hugo smiles.","Hugo sourit.",[0,91]],["Bip is part of the family now.","Bip fait partie de la famille maintenant.",[61,444,445,446,9,114,258]]]],"m":[290,423,424,427,301,69,430,445,316,50,12,14],"t":"Chapter 7 — Happy birthday!","tf":"Chapitre 7 — Joyeux anniversaire !"}],"questions":[{"q":"Que reçoit la famille de Hugo un samedi matin ?","o":["Une grande boîte avec un robot dedans","Un chat orange","Une télévision neuve"],"i":"Relis la page 1.","e":"Un homme apporte une grande boîte, cadeau de tante Nadia. Dedans, il y a Bip, un petit robot qui aide à la maison."},{"q":"Où Bip range-t-il les chaussettes ?","o":["Dans le frigo","Dans le tiroir","Dans la machine à laver"],"i":"C'est à la page 2.","e":"Maman demande à Bip de ranger les chaussettes. Bip les pose dans le frigo, à côté du lait et du fromage."},{"q":"Pourquoi Nougat est-il mouillé ?","o":["Bip le prend pour une plante et l'arrose","Il tombe dans la baignoire","Il saute dans la mer"],"i":"Regarde le chapitre 2, page 3.","e":"Bip voit quelque chose d'orange et de doux sur le canapé : il pense que c'est une plante et verse l'eau sur Nougat."},{"q":"Que fait Hugo pour aider Bip ?","o":["Il lui écrit des règles et les lui apprend","Il renvoie Bip dans la boîte","Il demande à maman de tout faire"],"i":"Chapitre 3, pages 5 et 6.","e":"Hugo écrit trois règles pour Bip : écouter, demander « C'est bien ça ? » et regarder d'abord."},{"q":"Quelle fête a lieu le dimanche ?","o":["L'anniversaire de papy, qui a soixante-dix ans","L'anniversaire de Hugo","Le mariage de tante Nadia"],"i":"Relis le début du chapitre 4.","e":"Aujourd'hui, c'est l'anniversaire de papy. Il a soixante-dix ans et il arrive à cinq heures."},{"q":"Que se passe-t-il avec le gâteau au chocolat ?","o":["Il tombe par terre quand Bip se retourne vite","Nougat le mange en entier","Il est brûlé dans le four"],"i":"C'est à la fin de la page 8.","e":"Nougat saute d'une chaise, Bip se retourne vite, son bras heurte la table et le gâteau tombe par terre."},{"q":"Que répond maman quand Hugo lui téléphone ?","o":["Faites un nouveau gâteau, mais n'utilisez pas le four tout seuls","Il n'y aura pas de gâteau cette année","Achetez un gâteau au magasin"],"i":"Regarde la fin de la page 9.","e":"Maman dit à Hugo de ne pas s'inquiéter : il peut faire un nouveau gâteau avec Bip, mais sans utiliser le four seul. Elle rentre dans une demi-heure."},{"q":"Quel cadeau Bip donne-t-il à papy ?","o":["Une boîte de chaussettes neuves","Un gâteau aux fraises","Un ballon bleu"],"i":"Lis la dernière page.","e":"Bip offre à papy une petite boîte pleine de chaussettes neuves. Papy rit : il en a justement besoin !"}]}
  "pages": [
    {
      "titre": "Chapter 6 — Jonas's secret",
      "titreFr": "Chapitre 6 — Le secret de Jonas",
      "p": [
        [
          {
            "en": "Jonas sat down on a wooden box and wiped his eyes.",
            "fr": "Jonas s'assit sur une caisse en bois et s'essuya les yeux.",
            "g": {
              "down": [
                "(sat down : s'assit)",
                "down",
                "d"
              ]
            }
          },
          {
            "en": "He said that he had not stolen anything.",
            "fr": "Il dit qu'il n'avait rien volé."
          },
          {
            "en": "During dinner, when he had gone to fetch the tablets, he had heard Mr Kessler talking on the phone in the corridor.",
            "fr": "Pendant le dîner, quand il était allé chercher les cachets, il avait entendu M. Kessler parler au téléphone dans le couloir.",
            "g": {
              "gone": [
                "allé",
                "go",
                "v",
                "aller"
              ],
              "heard": [
                "entendu",
                "hear",
                "v",
                "entendre"
              ]
            }
          },
          {
            "en": "Mr Kessler had said that the violin would be his before Vienna, and that nobody would notice until it was too late.",
            "fr": "M. Kessler avait dit que le violon serait à lui avant Vienne, et que personne ne s'en apercevrait avant qu'il soit trop tard.",
            "g": {
              "said": [
                "avait dit",
                "say",
                "v",
                "dire"
              ]
            }
          }
        ],
